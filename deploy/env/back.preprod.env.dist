# .env du back en preprod.
# À copier sur le VPS : /var/www/epa/foncier/api-foncier/shared/config/.env
APP_NAME="Foncier"
APP_CODE="FONCIER"

ENVIR=staging
HOST="https://api-foncier.luwen.fr"
# redirect_url : le front redirige vers ce paramètre après le login CAS (sinon /null).
DESKTOP_HOST="https://foncier.luwen.fr/?redirect_url=https://foncier.luwen.fr/"
DEBUG=false
SECRET_KEY_JWT=a-remplacer
# Ne jamais laisser vide : sans CAS, l'API connecte tout le monde en admin.
SERVER_CAS="https://connexion-data.epamarne-epafrance.fr/idp/cas"

MAILER_TYPE=SMTP
MAILER_API_KEY_PUBLIC=
MAILER_API_KEY_PRIVATE=
MAILER_API_KEY_SETTINGS=
MAILER_SMTP_HOST=
MAILER_SMTP_PORT=
MAILER_SMTP_USER=
MAILER_SMTP_PASSWORD=
MAILER_FROM="foncier-preprod@luwen.fr"
MAILER_SENDMAIL_CMD="sendmail -bs"

DATA_DRIVER_INMEMORY=pdo_sqlite
DATA_PATH_INMEMORY=:memory:
DATA_DB_SQLITE=
DATA_DB_TEST_SQLITE=

DATA_DRIVER=pdo_pgsql
DATA_DBNAME=foncier
DATA_USERNAME=foncier
DATA_PASSWORD=a-remplacer
DATA_HOST=postgres_foncier
DATA_PORT=5432
DATA_CHARSET=utf8

FILER_ADAPTER=local
FILER_LOCAL_PATH=/var/www/epa/foncier/api-foncier/shared/uploads

SI_API_URL=
SI_API_TOKEN=
